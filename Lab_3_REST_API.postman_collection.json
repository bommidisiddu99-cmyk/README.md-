    {
      "name": "8. POST /books (Success - 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 45.99\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Returns created book record and message\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('message');",
              "    pm.expect(data.book.title).to.equal(\"Designing Data-Intensive Applications\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
