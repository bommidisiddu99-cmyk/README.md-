  "item": [
    {
      "name": "1. GET /books (Default params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns an array of books\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. GET /books?search_q=Code (Search partial match)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?search_q=Code",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Code" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Results contain 'Code' in title\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.length).to.be.above(0);",
              "    pm.expect(data[0].title.toLowerCase()).to.include(\"code\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. GET /books?order_by=price&order=DESC (Sorting)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?order_by=price&order=DESC",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"First item has highest price\", function () {",
              "    var data = pm.response.json();",
              "    if (data.length > 1) {",
              "        pm.expect(data[0].price).to.be.at.least(data[1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. GET /books?min_price=10&max_price=30 (Price range filter)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?min_price=10&max_price=30",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "min_price", "value": "10" },
            { "key": "max_price", "value": "30" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"All books are between 10 and 30\", function () {",
              "    var data = pm.response.json();",
              "    data.forEach(function(b) {",
              "        pm.expect(b.price).to.be.at.least(10);",
              "        pm.expect(b.price).to.be.at.most(30);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
